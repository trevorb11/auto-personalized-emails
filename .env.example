# ── MCA Prospecting Agent Configuration ──────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Anthropic API ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── GoHighLevel ──────────────────────────────────────────────
# Get these from GHL → Settings → Private Integrations
# Scopes needed: Contacts, Conversations, Opportunities, Calendars
GHL_API_KEY=your-pit-token
GHL_LOCATION_ID=your-location-id
GHL_BASE_URL=https://services.leadconnectorhq.com

# ── Google Maps / Places API ────────────────────────────────
# Create at console.cloud.google.com → APIs → Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Google Custom Search Engine (inbound lead discovery) ─────
# NOTE: Google has closed the Custom Search JSON API to new customers
# and scheduled it for retirement — plan a replacement search source.
# 1. Enable Custom Search JSON API at console.cloud.google.com
# 2. Create a search engine at cse.google.com
#    Tip: restrict to yelp.com, bbb.org, yellowpages.com for
#    better business discovery results
GOOGLE_CSE_API_KEY=your-google-cse-api-key
GOOGLE_CSE_ID=your-search-engine-id

# ── Hunter.io (email finder) ────────────────────────────────
# Sign up at hunter.io — free tier = 25 searches/month
# Used to find decision-maker emails from business websites
HUNTER_API_KEY=your-hunter-api-key

# ── Clearbit (company enrichment) ───────────────────────────
# NOTE: Clearbit's standalone Enrichment API was folded into HubSpot
# and is no longer sold to new customers. Existing keys keep working;
# leave blank otherwise (the pipeline skips it).
CLEARBIT_API_KEY=your-clearbit-api-key

# ── Google Ads (MCP server for campaign data) ────────────────
# Setup: console.cloud.google.com → APIs → Google Ads API
# These power the Google Ads MCP server for campaign performance queries
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-client-id
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=your-customer-id

# ── Apify (web scraping — 3,000+ actors) ────────────────────
# Sign up at apify.com — free tier available
# Key actor: apify/google-maps-scraper for business discovery
APIFY_API_TOKEN=your-apify-token

# ── Slack Webhook ────────────────────────────────────────────
# Create at api.slack.com → Your Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Agent Settings ───────────────────────────────────────────
CLAUDE_MODEL=claude-opus-5-5
MAX_TOKENS=8192

# Let Claude rewrite A-tier template emails (facts are validated; template is the fallback)
EMAIL_LLM_PERSONALIZE=false

# ── Outreach identity & compliance ──────────────────────────
# CAN-SPAM requires a physical postal address + opt-out in every
# commercial email. Leads are flagged in sales notes until this is set.
SENDER_NAME=
SENDER_COMPANY=Today Capital Group
SENDER_ADDRESS=
SENDER_PHONE=

# ── UCC renewal window (filing age, in months) ──────────────
UCC_MIN_AGE_MONTHS=5
UCC_MAX_AGE_MONTHS=15
UCC_FILINGS_PER_STATE=250

# Start in dry run mode (logs actions without writing to GHL)
# Set to "false" once you trust the output
DRY_RUN=true

# ── Daily Safety Caps ───────────────────────────────────────
DAILY_GHL_CREATES=100
DAILY_GOOGLE_LOOKUPS=200
DAILY_CSE_SEARCHES=50
DAILY_HUNTER_LOOKUPS=25
DAILY_CLEARBIT_LOOKUPS=50
DAILY_CLAUDE_TOKENS=500000

# ── Target States (comma-separated) ─────────────────────────
TARGET_STATES=FL,CA,NY,TX
